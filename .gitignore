*.egg

# Virtual environments
venv/
.venv/
env/
ENV/

# IDE & editors
.idea/
.vscode/
*.swp
*.swo

# Runtime storage (preserve folders with .gitkeep)
uploads/*
!uploads/.gitkeep
output/*
!output/.gitkeep

# OS specific files
Thumbs.db
desktop.ini
.DS_Store

# Exclude generated files
# Decrypted image from UI
decrypted.png
